# ===========================================
# CodePass Backend - Variables d'environnement
# ===========================================
# Copiez ce fichier vers .env et renseignez les valeurs.
# Ne commitez jamais le fichier .env !

# --- Base de données ---
DATABASE_URL="postgresql://username:password@localhost:5432/gestion_mdp?schema=public"

# --- Sécurité (obligatoire en production) ---
# Générer une clé API : npm run generate-api-key
API_KEY=""
# Clé secondaire optionnelle (rotation)
API_KEY_SECONDARY=""

# JWT (obligatoire en production)
JWT_SECRET=""
JWT_EXPIRES_IN="24h"

# Bcrypt (nombre de rounds, défaut 12)
BCRYPT_ROUNDS=12

# --- Serveur ---
PORT=3001
NODE_ENV="development"

# CORS : origines autorisées (séparées par des virgules en production)
# Inclure capacitor://localhost pour l'app mobile Android/iOS (CodePass Mobile)
CORS_ORIGIN="http://localhost:5173,capacitor://localhost"

# À activer derrière un reverse proxy (Nginx, etc.)
TRUST_PROXY=false

# URL publique du backend (pour les liens dans les emails)
BACKEND_URL="http://localhost:3001"

# --- Frontend ---
FRONTEND_URL="http://localhost:5173"

# --- Email (SMTP) - pour réinitialisation mot de passe ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gestionnaire de Mots de Passe <noreply@example.com>"

# --- Réinitialisation mot de passe ---
PASSWORD_RESET_TOKEN_EXPIRATION=15
PASSWORD_RESET_MAX_ATTEMPTS=3

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Optionnel ---
# IPs bloquées (séparées par des virgules)
# BLOCKED_IPS=""
# Nombre max de mots de passe par utilisateur
MAX_PASSWORDS_PER_USER=1000
