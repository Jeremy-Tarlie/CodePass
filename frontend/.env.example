# ===========================================
# CodePass Frontend - Variables d'environnement
# ===========================================
# Copiez ce fichier vers .env et renseignez les valeurs.
# Ces variables sont exposées au build (préfixe VITE_).

# --- API Backend ---
# URL du serveur backend
VITE_API_URL=http://localhost:3001

# Clé API (même valeur que API_KEY du backend)
# Générer avec : cd back && npm run generate-api-key
VITE_API_KEY=

# --- Application ---
VITE_APP_NAME=Gestionnaire de Mots de Passe
VITE_APP_VERSION=1.0.0
