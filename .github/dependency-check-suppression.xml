<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!-- ejs CVE-2023-29827 : disputé par les mainteneurs, pas de correctif officiel (usage avec entrée non fiable = hors scope). Voir https://github.com/mde/ejs/issues/735 -->
  <suppress>
    <notes><![CDATA[ejs CVE-2023-29827 disputed by maintainers, no fix. Do not pass untrusted input to EJS render().]]></notes>
    <packageUrl regex="true">pkg:npm/ejs@.*</packageUrl>
    <cve>CVE-2023-29827</cve>
  </suppress>

  <!-- Squirrel / SyncReleases : binaires fournis par electron-builder pour les mises à jour Windows. Utilisés uniquement au build, pas exposés en production. -->
  <suppress>
    <notes><![CDATA[Squirrel.Windows / Mono / SyncReleases - binaires electron-builder (Windows), build-time only, not exposed at runtime.]]></notes>
    <filePath regex="true">.*(Squirrel|SyncReleases).*\.exe$</filePath>
    <cve>CVE-2015-2320</cve>
    <cve>CVE-2015-2319</cve>
    <cve>CVE-2015-2318</cve>
    <cve>CVE-2020-10518</cve>
    <cve>CVE-2020-10519</cve>
    <cve>CVE-2012-2055</cve>
  </suppress>
</suppressions>
